# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real secrets.

# === Database ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234

# === RabbitMQ ===
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# === Eureka ===
EUREKA_URL=http://localhost:8761/eureka

# === JWT ===
# Generate a strong base64 secret for production:
#   openssl rand -base64 64
JWT_SECRET=ZWNvbW1lcmNlLXNhZ2EtanNvbi13ZWItdG9rZW4tc2VjcmV0LWtleS1mb3ItYm9vdGNhbXAtcHJvamVjdC0xMjM0NTY=
JWT_EXPIRATION_MS=86400000

# === Iyzico Sandbox ===
# Get yours from https://sandbox-merchant.iyzipay.com → Settings → API Keys
IYZICO_API_KEY=sandbox-YOUR_KEY_HERE
IYZICO_SECRET_KEY=sandbox-YOUR_SECRET_HERE
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
